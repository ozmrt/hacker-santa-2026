# ESP32-2424S012 capacitive-touch board. Bare board; no external peripherals.
CONFIG_BUILD_CONFIG_TEMPLATE="sunton_esp32_2424s012"
CONFIG_SUNTON_ESP32_2424S012=y
CONFIG_WITH_SCREEN=y
CONFIG_USE_TOUCHSCREEN=y
CONFIG_TFT_WIDTH=240
CONFIG_TFT_HEIGHT=240
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
# Leave room for menu/keyboard allocations when Wi-Fi resumes after BLE.
# The upstream 16 static TX buffers reserve 25.6 KB on this no-PSRAM board.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
# CONFIG_HAS_GPS is not set
# CONFIG_HAS_NFC is not set
# CONFIG_NFC_CHAMELEON is not set
# CONFIG_NFC_PN532 is not set
# CONFIG_USE_ENCODER is not set
# CONFIG_USE_JOYSTICK is not set
# CONFIG_HAS_BATTERY is not set
# CONFIG_HAS_BADUSB is not set
# CONFIG_ENABLE_NATIVE_SD_APPS is not set
# CONFIG_ENABLE_GHOSTSCRIPT is not set
# CONFIG_USING_SPI is not set
# CONFIG_USING_MMC is not set
# CONFIG_USING_MMC_1_BIT is not set
CONFIG_RED_RGB_PIN=-1
CONFIG_GREEN_RGB_PIN=-1
CONFIG_BLUE_RGB_PIN=-1

# GC9A01, SPI mode 0, BGR, inversion; software reset (no wired LCD reset).
CONFIG_LV_PREDEFINED_DISPLAY_NONE=y
CONFIG_LV_TFT_DISPLAY_USER_CONTROLLER_GC9A01=y
# CONFIG_LV_TFT_DISPLAY_USER_CONTROLLER_ILI9341 is not set
CONFIG_LV_TFT_DISPLAY_CONTROLLER_GC9A01=y
# CONFIG_LV_TFT_DISPLAY_CONTROLLER_ILI9341 is not set
CONFIG_LV_TFT_DISPLAY_PROTOCOL_SPI=y
CONFIG_LV_TFT_DISPLAY_SPI2_HOST=y
CONFIG_LV_TFT_DISPLAY_SPI_TRANS_MODE_SIO=y
CONFIG_LV_TFT_DISPLAY_SPI_HALF_DUPLEX=y
CONFIG_LV_TFT_USE_CUSTOM_SPI_CLK_DIVIDER=y
CONFIG_LV_TFT_SPI_CLK_DIVIDER_4=y
# CONFIG_LV_TFT_SPI_CLK_DIVIDER_1 is not set
# CONFIG_LV_TFT_SPI_CLK_DIVIDER_2 is not set
CONFIG_LV_TFT_CUSTOM_SPI_CLK_DIVIDER=4
CONFIG_LV_HOR_RES_MAX=240
CONFIG_LV_VER_RES_MAX=240
CONFIG_LV_DISPLAY_ORIENTATION_PORTRAIT=y
CONFIG_LV_DISPLAY_ORIENTATION=0
CONFIG_LV_INVERT_COLORS=y
CONFIG_LV_DISP_SPI_CLK=6
CONFIG_LV_DISP_SPI_MOSI=7
# CONFIG_LV_DISPLAY_USE_SPI_MISO is not set
CONFIG_LV_DISPLAY_USE_SPI_CS=y
CONFIG_LV_DISP_SPI_CS=10
CONFIG_LV_DISPLAY_USE_DC=y
CONFIG_LV_DISP_PIN_DC=2
# CONFIG_LV_DISP_USE_RST is not set
# CONFIG_LV_DISP_BACKLIGHT_OFF is not set
# CONFIG_LV_DISP_BACKLIGHT_PWM is not set
CONFIG_LV_DISP_BACKLIGHT_SWITCH=y
CONFIG_LV_DISP_PIN_BCKL=3
CONFIG_LV_BACKLIGHT_ACTIVE_LVL=y

# CST816D/S: address 0x15; reset=1 and IRQ=0 handled by board driver.
CONFIG_LV_TOUCH_CONTROLLER_CST820=y
# CONFIG_LV_TOUCH_CONTROLLER_GT911 is not set
CONFIG_LV_TOUCH_CONTROLLER=8
CONFIG_LV_I2C=y
CONFIG_LV_I2C_TOUCH=y
CONFIG_LV_I2C_TOUCH_PORT_0=y
# CONFIG_LV_I2C_TOUCH_PORT_1 is not set
CONFIG_LV_I2C_TOUCH_PORT=0
CONFIG_I2C_MANAGER_0_ENABLED=y
CONFIG_I2C_MANAGER_0_SDA=4
CONFIG_I2C_MANAGER_0_SCL=5
CONFIG_I2C_MANAGER_0_FREQ_HZ=100000
CONFIG_I2C_MANAGER_0_TIMEOUT=20
CONFIG_I2C_MANAGER_0_LOCK_TIMEOUT=50
# CONFIG_I2C_MANAGER_1_ENABLED is not set
CONFIG_LV_INDEV_DEF_READ_PERIOD=10

# Compile out DEBUG/VERBOSE while retaining explicit INFO heap diagnostics.
# Runtime remains WARN. Silent checks still abort on failed assertions/errors.
# CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE is not set
# CONFIG_LOG_MAXIMUM_LEVEL_DEBUG is not set
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL=3
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE is not set
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTION_LEVEL=1
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
