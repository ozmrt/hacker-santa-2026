diff --git a/main/managers/views/orbital_view.c b/main/managers/views/orbital_view.c
new file mode 100644
index 0000000..5fc1ee1
--- /dev/null
+++ b/main/managers/views/orbital_view.c
@@ -0,0 +1,172 @@
+#include "sdkconfig.h"
+#ifdef CONFIG_SUNTON_ESP32_2424S012
+#include "managers/views/orbital_view.h"
+#include "managers/views/app_gallery_screen.h"
+#include "gui/orbital_game.h"
+#include "esp_timer.h"
+#include <stdio.h>
+#include <string.h>
+static orbital_game_t game;
+static lv_obj_t *root,*hud,*panel,*buttons[3];
+static lv_timer_t *timer;
+static View *return_view;
+static uint32_t last_ms,accumulator,last_score;
+static uint8_t last_lives;
+static bool paused,center_press;
+static int pressed_button=-1;
+void orbital_set_return_view(View *view) {return_view=view;}
+static void point(const orbit_body_t *b,int *x,int *y) {orbital_point(b->angle,b->radius,x,y);}
+static void line(lv_draw_ctx_t *ctx,int x1,int y1,int x2,int y2,uint32_t color,unsigned width) {
+    lv_area_t bounds={LV_MIN(x1,x2)-2,LV_MIN(y1,y2)-2,LV_MAX(x1,x2)+2,LV_MAX(y1,y2)+2},a;
+    if(!_lv_area_intersect(&a,&bounds,ctx->clip_area)) return;
+    lv_draw_line_dsc_t d;lv_draw_line_dsc_init(&d);d.color=lv_color_hex(color);d.width=width;
+    lv_point_t p={(lv_coord_t)x1,(lv_coord_t)y1},q={(lv_coord_t)x2,(lv_coord_t)y2};
+    lv_draw_line(ctx,&d,&p,&q);
+}
+static void draw(lv_event_t *e) {
+    lv_draw_ctx_t *c=lv_event_get_draw_ctx(e);
+    /* Sparse stationary vector stars; no background bitmap or framebuffer. */
+    for(unsigned i=0;i<14;i++) {
+        int x,y;orbital_point((uint16_t)(i*73),(uint16_t)((40+(i*19)%65)*256),&x,&y);
+        line(c,x-1,y,x+1,y,0x233650,1);
+    }
+    int ax,ay,bx,by,cx,cy;
+    orbital_point(game.angle,89*256,&ax,&ay);
+    orbital_point((game.angle+12)&1023,103*256,&bx,&by);
+    orbital_point((game.angle-12)&1023,103*256,&cx,&cy);
+    line(c,ax,ay,bx,by,0x54fff0,2);line(c,bx,by,cx,cy,0x54fff0,2);line(c,cx,cy,ax,ay,0x54fff0,2);
+    for(unsigned i=0;i<ORBIT_SHOTS;i++) if(game.shots[i].active) {
+        const orbit_body_t *b=&game.shots[i];point(b,&ax,&ay);
+        orbital_point(b->angle,b->radius+3*256,&bx,&by);line(c,ax,ay,bx,by,0xf0f080,1);
+    }
+    for(unsigned i=0;i<ORBIT_ENEMIES;i++) if(game.enemies[i].active) {
+        point(&game.enemies[i],&ax,&ay);uint32_t color=game.enemies[i].kind?0xff4baf:0x60a4ff;
+        line(c,ax,ay-5,ax+5,ay,color,1);line(c,ax+5,ay,ax,ay+5,color,1);
+        line(c,ax,ay+5,ax-5,ay,color,1);line(c,ax-5,ay,ax,ay-5,color,1);
+    }
+    for(unsigned i=0;i<ORBIT_BURSTS;i++) if(game.bursts[i].active) {
+        point(&game.bursts[i],&ax,&ay);int r=12-game.bursts[i].active;
+        line(c,ax-r,ay-r,ax+r,ay+r,0xffb44c,1);line(c,ax-r,ay+r,ax+r,ay-r,0xffb44c,1);
+    }
+}
+static void dirty_body(const orbit_body_t *old,const orbit_body_t *now,int radius) {
+    if(!old->active && !now->active)return;
+    int x,y;point(old->active?old:now,&x,&y);
+    lv_area_t a={x-radius,y-radius,x+radius,y+radius};
+    if(old->active && now->active) {
+        point(now,&x,&y);a.x1=LV_MIN(a.x1,x-radius);a.y1=LV_MIN(a.y1,y-radius);
+        a.x2=LV_MAX(a.x2,x+radius);a.y2=LV_MAX(a.y2,y+radius);
+    }
+    lv_obj_invalidate_area(root,&a);
+}
+static void update_hud(void) {
+    if(last_score==game.score && last_lives==game.lives)return;
+    char text[48];snprintf(text,sizeof(text),"%lu   L%u\nLives %u",(unsigned long)game.score,game.level,game.lives);
+    lv_label_set_text(hud,text);last_score=game.score;last_lives=game.lives;
+}
+static void show_pause(bool opening);
+static void tick(lv_timer_t *t) {
+    (void)t;uint32_t now=(uint32_t)(esp_timer_get_time()/1000),elapsed=now-last_ms;last_ms=now;
+    if(display_manager_is_lockscreen_active()) {if(!paused)show_pause(false);return;}
+    if(paused)return;
+    if(elapsed>64)elapsed=64;
+    accumulator+=elapsed;
+    if(accumulator<ORBIT_STEP_MS)return;
+    orbital_game_t old=game; /* Bounded stack snapshot for dirty-region unions. */
+    while(accumulator>=ORBIT_STEP_MS) {orbital_game_step(&game);accumulator-=ORBIT_STEP_MS;}
+    orbit_body_t previous={old.angle,98*256,1,0},current={game.angle,98*256,1,0};
+    dirty_body(&previous,&current,12);
+    for(unsigned i=0;i<ORBIT_ENEMIES;i++) dirty_body(&old.enemies[i],&game.enemies[i],7);
+    for(unsigned i=0;i<ORBIT_SHOTS;i++) dirty_body(&old.shots[i],&game.shots[i],5);
+    for(unsigned i=0;i<ORBIT_BURSTS;i++) dirty_body(&old.bursts[i],&game.bursts[i],13);
+    update_hud();
+    if(!game.lives)show_pause(false);
+}
+static void restart(void) {
+    orbital_game_init(&game,0x47595255);last_score=UINT32_MAX;last_lives=255;
+    accumulator=0;update_hud();lv_obj_invalidate(root);
+}
+static void hide_pause(void) {
+    if(panel)lv_obj_del(panel);
+    panel=NULL;memset(buttons,0,sizeof(buttons));
+    paused=false;center_press=false;pressed_button=-1;
+}
+static void show_pause(bool opening) {
+    paused=true;if(panel) return;
+    panel=lv_obj_create(root);lv_obj_set_pos(panel,46,55);lv_obj_set_size(panel,148,130);
+    lv_obj_set_style_pad_all(panel,0,0);lv_obj_set_style_radius(panel,8,0);
+    lv_obj_set_style_bg_color(panel,lv_color_hex(0x091426),0);
+    lv_obj_set_style_text_color(panel,lv_color_hex(0xe6f3ff),0);
+    lv_obj_set_style_bg_opa(panel,LV_OPA_COVER,0);lv_obj_clear_flag(panel,LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_t *title=lv_label_create(panel);lv_label_set_text(title,!game.lives?"GAME OVER":opening?"ORBITAL VECTOR":"PAUSED");
+    lv_obj_align(title,LV_ALIGN_TOP_MID,0,4);
+    lv_obj_t *hint=lv_label_create(panel);lv_label_set_text(hint,"Drag rim; auto-fire");
+#if LV_FONT_MONTSERRAT_10
+    lv_obj_set_style_text_font(hint,&lv_font_montserrat_10,0);
+#endif
+    lv_obj_align(hint,LV_ALIGN_TOP_MID,0,21);
+    unsigned count=game.lives?3:2;
+    const char *labels[3]={opening?"Play":"Resume","Restart","Back"};
+    if(!game.lives){labels[0]="Retry";labels[1]="Back";}
+    for(unsigned i=0;i<count;i++) {
+        buttons[i]=lv_btn_create(panel);lv_obj_set_pos(buttons[i],13,36+i*29);lv_obj_set_size(buttons[i],120,25);
+        lv_obj_t *label=lv_label_create(buttons[i]);lv_label_set_text(label,labels[i]);lv_obj_center(label);
+    }
+}
+static void input(InputEvent *event) {
+    if(event->type==INPUT_TYPE_JOYSTICK && event->data.joystick_pressed) {
+        if(event->data.joystick_index==0)game.target=(game.target-32)&1023;
+        else if(event->data.joystick_index==3)game.target=(game.target+32)&1023;
+        else if(event->data.joystick_index==1) {if(paused){if(!game.lives)restart();hide_pause();}else show_pause(false);}
+        return;
+    }
+    if(event->type!=INPUT_TYPE_TOUCH)return;
+    lv_indev_data_t *touch=&event->data.touch_data;int x=touch->point.x,y=touch->point.y;
+    if(paused) {
+        if(touch->state==LV_INDEV_STATE_PR && !event->is_touch_move) {
+            pressed_button=-1;
+            for(int i=0;i<3;i++) if(buttons[i]) {
+                lv_area_t a;lv_obj_get_coords(buttons[i],&a);
+                if(x>=a.x1 && x<=a.x2 && y>=a.y1 && y<=a.y2)pressed_button=i;
+            }
+        } else if(touch->state==LV_INDEV_STATE_REL) {
+            int i=pressed_button;pressed_button=-1;
+            if(i<0 || !buttons[i])return;
+            lv_area_t a;lv_obj_get_coords(buttons[i],&a);
+            if(x<a.x1 || x>a.x2 || y<a.y1 || y>a.y2)return;
+            if((game.lives && i==2)||(!game.lives && i==1)) {
+                display_manager_switch_view(return_view?return_view:&apps_menu_view);return;
+            }
+            if(i==1 || !game.lives)restart();
+            hide_pause();
+        }
+        return;
+    }
+    int dx=x-120,dy=y-120,r2=dx*dx+dy*dy;
+    if(touch->state==LV_INDEV_STATE_PR) {
+        if(!event->is_touch_move)center_press=r2<28*28;
+        if(r2>40*40) {game.target=orbital_touch_angle(x,y);center_press=false;}
+    } else {if(center_press && r2<28*28)show_pause(false);center_press=false;}
+}
+static void create(void) {
+    display_manager_set_status_bar_hidden(true);
+    root=lv_obj_create(lv_scr_act());orbital_view.root=root;lv_obj_remove_style_all(root);
+    lv_obj_set_pos(root,0,0);lv_obj_set_size(root,240,240);lv_obj_clear_flag(root,LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_opa(root,LV_OPA_COVER,0);lv_obj_set_style_bg_color(root,lv_color_black(),0);
+    lv_obj_add_event_cb(root,draw,LV_EVENT_DRAW_MAIN,NULL);
+    hud=lv_label_create(root);lv_obj_set_size(hud,94,36);lv_obj_set_pos(hud,73,102);
+    lv_obj_set_style_text_align(hud,LV_TEXT_ALIGN_CENTER,0);lv_obj_set_style_text_color(hud,lv_color_hex(0xaabbd0),0);
+    restart();paused=false;show_pause(true);
+    last_ms=(uint32_t)(esp_timer_get_time()/1000);timer=lv_timer_create(tick,16,NULL);
+}
+static void destroy(void) {
+    if(timer)lv_timer_del(timer);
+    timer=NULL;
+    if(root)lv_obj_del(root);
+    root=hud=panel=NULL;orbital_view.root=NULL;
+    memset(buttons,0,sizeof(buttons));paused=false;center_press=false;pressed_button=-1;
+    display_manager_set_status_bar_hidden(false);
+}
+static void get_callback(void **callback) {*callback=input;}
+View orbital_view={.root=NULL,.create=create,.destroy=destroy,.name="Orbital Vector",.get_hardwareinput_callback=get_callback,.input_callback=input};
+#endif
