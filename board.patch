+  return '"' + text.replace(/"/g, '""') + '"';
+}
+function reconDownload(format) {
+  if (!reconRows.length) { toast('Collect a snapshot first', 'warn'); return; }
+  const fields = ['radio', 'address', 'name', 'rssi', 'channel', 'seen', 'samples', 'firstSeen', 'lastSeen'];
+  const payload = format === 'json'
+    ? JSON.stringify({ schema: 1, source: 'GhostESP Recon', exportedAt: new Date().toISOString(), observations: reconRows }, null, 2)
+    : [fields.join(','), ...reconRows.map(row => fields.map(field => reconCsvCell(row[field])).join(','))].join('\r\n') + '\r\n';
