+async function reconCollect() {
+  try {
+    const res = await api('/api/recon', { cache: 'no-store' });
+    if (!res.ok) throw new Error((await res.text()).slice(0, 100) || `HTTP ${res.status}`);
+    const data = await res.json();
+    if (!Array.isArray(data.items)) throw new Error('Invalid snapshot');
+    reconCurrent = new Map();
+    let added = 0;
+    const now = new Date().toISOString();
+    for (const item of data.items) {
+      if (!reconValid(item)) continue;
+      item.address = item.address.toUpperCase();
+      item.name = String(item.name || '').slice(0, 32);
+      const key = reconKey(item);
+      reconCurrent.set(key, item);
+      let row = reconRows.find(candidate => reconKey(candidate) === key);
+      if (!row) {
+        row = { radio: item.radio, address: item.address, firstSeen: now, samples: 0 };
+        reconRows.push(row);
+        if (reconRows.length > RECON_LIMIT) reconRows.shift();
+        added++;
