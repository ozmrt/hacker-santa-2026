+.recon-severity { min-width: 120px; border: 1px solid var(--recon-border); padding: 14px; text-align: center; background: rgba(159,255,197,.05); }
+.recon-severity strong { display: block; color: var(--recon-lime); font-size: 2.4rem; line-height: 1; }
+.recon-severity span { display: block; margin-top: 6px; font-size: .68rem; text-transform: uppercase; }
+.recon-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 16px 0; }
+.recon-panel { border: 1px solid var(--recon-border); background: #0c1511; padding: 18px; margin-bottom: 12px; }
+.recon-panel h2 { color: var(--recon-lime); font: 700 1rem var(--mono); letter-spacing: .06em; }
+.recon-panel p { margin: 9px 0 14px; color: #b9cfc3; line-height: 1.5; font-size: .8rem; }
+.recon-actions { flex-wrap: wrap; }
+.recon-shell .btn.primary { background: var(--recon-lime); color: #092016; }
+.recon-shell .btn.ghost { border-color: var(--recon-border); color: var(--recon-ink); }
+.recon-hint { margin-bottom: 0 !important; font-size: .72rem !important; }
+.recon-stats { display: flex; align-items: baseline; gap: 8px; margin: 12px 0; }
+.recon-stats strong { color: var(--recon-lime); font-size: 2rem; }
+.recon-stats span { font-size: .7rem; color: #b9cfc3; }
+.recon-results { max-height: 420px; overflow: auto; }
+.recon-result { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; padding: 10px 0; border-top: 1px solid var(--recon-border); align-items: center; }
+.recon-result-name { overflow-wrap: anywhere; font-weight: 700; font-size: .84rem; }
+.recon-result-meta { overflow-wrap: anywhere; color: #b9cfc3; font-size: .72rem; margin-top: 4px; }
+.recon-result button { border: 1px solid var(--recon-border); padding: 7px 9px; color: var(--recon-lime); font: 700 .68rem var(--mono); }
+.recon-result button:disabled { opacity: .45; cursor: default; }
+.recon-footnote { color: #b9cfc3; padding: 10px 0 20px; font-size: .72rem; line-height: 1.5; }
+.recon-footnote button { color: var(--recon-lime); text-decoration: underline; padding: 0; }
+.recon-safety-dialog { border-color: rgba(159,255,197,.45); background: #0c1511; }
+.recon-safety-dialog code { display: block; overflow-wrap: anywhere; padding: 12px; border: 1px solid rgba(159,255,197,.26); color: #9fffc5; margin-bottom: 14px; }
+@media (max-width: 680px) { .recon-grid { grid-template-columns: 1fr; } .recon-hero { align-items: flex-start; flex-direction: column; } }
+
 .progress { height: 8px; overflow: hidden; border-radius: 999px; background: var(--panel-3); border: 1px solid var(--line); }
 .progress > span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, rgba(255,255,255,.35), rgba(255,255,255,.75)); transition: width .25s ease; }
 
diff --git a/webui/tests/recon.test.mjs b/webui/tests/recon.test.mjs
new file mode 100644
index 0000000..434e877
--- /dev/null
+++ b/webui/tests/recon.test.mjs
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import test from 'node:test';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const source = fs.readFileSync(path.join(here, '..', 'src', 'app.js'), 'utf8')
+  .replace(/\binit\(\);\s*$/, '');
+const elements = new Map();
+function node() {
+  return {
+    children: [], textContent: '',
+    set innerHTML(_) { throw new Error('Untrusted HTML reached the DOM'); },
+    append(...children) { this.children.push(...children); },
+    appendChild(child) { this.children.push(child); },
+    replaceChildren() { this.children = []; },
+    addEventListener() {},
+  };
+}
+const context = vm.createContext({
+  document: {
+    createElement: () => node(),
+    getElementById(id) {
+      if (!elements.has(id)) elements.set(id, node());
+      return elements.get(id);
+    },
+  },
+});
+vm.runInContext(source, context, { filename: 'app.js' });
+
+test('Recon displays hostile radio names as text', () => {
+  vm.runInContext(`reconRows = [{ radio: 'wifi', address: 'AA:BB:CC:00:11:22',
+    name: '<img src=x onerror=alert(1)>', rssi: -60, channel: 6, samples: 1 }];
+    reconRender();`, context);
+  const result = elements.get('recon-results').children[0];
+  assert.match(result.children[0].children[0].textContent, /<img src=x onerror=alert\(1\)>/);
+});
+
+test('Recon CSV neutralizes formula cells and quotes', () => {
+  assert.equal(vm.runInContext(`reconCsvCell(' =1+1')`, context), `"' =1+1"`);
+  assert.equal(vm.runInContext(`reconCsvCell('@SUM(1)')`, context), `"'@SUM(1)"`);
+  assert.equal(vm.runInContext(`reconCsvCell('a"b')`, context), '"a""b"');
+});
