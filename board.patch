+    49,46,43,40,37,34,31,28,25,22,19,16,12,9,6,3,
+    0,-3,-6,-9,-12,-16,-19,-22,-25,-28,-31,-34,-37,-40,-43,-46,
+    -49,-51,-54,-57,-60,-63,-65,-68,-71,-73,-76,-78,-81,-83,-85,-88,
+    -90,-92,-94,-96,-98,-100,-102,-104,-106,-107,-109,-111,-112,-113,-115,-116,
+    -117,-118,-120,-121,-122,-122,-123,-124,-125,-125,-126,-126,-126,-127,-127,-127,
+    -127,-127,-127,-127,-126,-126,-126,-125,-125,-124,-123,-122,-122,-121,-120,-118,
+    -117,-116,-115,-113,-112,-111,-109,-107,-106,-104,-102,-100,-98,-96,-94,-92,
+    -90,-88,-85,-83,-81,-78,-76,-73,-71,-68,-65,-63,-60,-57,-54,-51,
+    -49,-46,-43,-40,-37,-34,-31,-28,-25,-22,-19,-16,-12,-9,-6,-3,
+};
+static const uint16_t palette[256] = {
+    0x1024,0x1024,0x1824,0x1824,0x1824,0x1824,0x1825,0x1825,0x2045,0x2045,0x2045,0x2046,
+    0x2046,0x2846,0x2846,0x2847,0x2847,0x3047,0x3048,0x3048,0x3848,0x3868,0x3869,0x4069,
+    0x4069,0x4069,0x486a,0x486a,0x486a,0x506b,0x506b,0x586b,0x588c,0x588c,0x608c,0x608c,
+    0x688d,0x688d,0x688d,0x708d,0x708e,0x708e,0x788e,0x78ae,0x78ae,0x80ae,0x80ae,0x80af,
+    0x80af,0x88af,0x88af,0x88af,0x90af,0x90af,0x90cf,0x98cf,0x98cf,0x98cf,0x98cf,0xa0cf,
+    0xa0d0,0xa0d0,0xa8d0,0xa8d0,0xa8d0,0xa8f0,0xb0f0,0xb0ef,0xb0ef,0xb0ef,0xb8ef,0xb8ef,
+    0xb8ef,0xb8ef,0xc0ef,0xc0ef,0xc0ef,0xc0ef,0xc90f,0xc90f,0xc90f,0xc90e,0xd10e,0xd10e,
+    0xd10e,0xd10e,0xd10e,0xd90e,0xd90d,0xd90d,0xd90d,0xd90d,0xe10d,0xe10c,0xe12c,0xe12c,
+    0xe12c,0xe12c,0xe92b,0xe92b,0xe92b,0xe92b,0xe92a,0xe92a,0xe92a,0xf12a,0xf129,0xf129,
+    0xf129,0xf129,0xf128,0xf128,0xf128,0xf128,0xf127,0xf927,0xf927,0xf926,0xf926,0xf926,
+    0xf926,0xf925,0xf925,0xf945,0xf945,0xf965,0xf965,0xf985,0xf9a5,0xf9a5,0xf9c5,0xf9e5,
+    0xf9e5,0xfa05,0xfa05,0xfa25,0xfa45,0xfa45,0xfa65,0xfa65,0xfa85,0xfaa5,0xf2a5,0xf2c5,
+    0xf2c5,0xf2e5,0xf2e5,0xf305,0xf304,0xf324,0xf324,0xf344,0xeb44,0xeb64,0xeb64,0xeb84,
+    0xeb84,0xeba4,0xeba4,0xe3c4,0xe3c4,0xe3c4,0xe3e4,0xe3e4,0xe3e4,0xdc04,0xdc04,0xdc04,
+    0xdc24,0xdc24,0xd424,0xd444,0xd444,0xd444,0xd444,0xcc64,0xcc64,0xcc64,0xcc64,0xc464,
+    0xc464,0xc484,0xc484,0xbc84,0xbc83,0xbc83,0xbc83,0xb483,0xb483,0xb483,0xb483,0xac83,
+    0xac83,0xac83,0xac83,0xa483,0xa483,0xa483,0x9c63,0x9c63,0x9c63,0x9c63,0x9463,0x9463,
+    0x9443,0x8c43,0x8c43,0x8c43,0x8422,0x8422,0x8402,0x7c02,0x7be2,0x73c2,0x73c2,0x6ba2,
+    0x6b82,0x6382,0x6362,0x6362,0x5b42,0x5b22,0x5322,0x5302,0x52e2,0x4ae2,0x4ac2,0x4ac2,
+    0x42a2,0x4282,0x4281,0x3a61,0x3a61,0x3a41,0x3241,0x3221,0x3201,0x3201,0x29e1,0x29e1,
+    0x29c1,0x29c1,0x21a1,0x21a1,0x2181,0x2181,0x1961,0x1961,0x1941,0x1941,0x1921,0x1921,
+    0x1121,0x1101,0x1101,0x1101,
+};
+
+/* GCC -Os used hardware DIV even for constant signed /2 and /128.
+ * Explicit rounding correction preserves truncation toward zero, then shifts.
+ * Both supported host/ESP toolchains use arithmetic signed right shifts. */
+static inline int half(int v) {return (v+(int)((unsigned)v>>31))>>1;}
+static inline int q7(int v) {return (v+(v<0?127:0))>>7;}
+
+void round_demo_render(uint16_t *dst, unsigned stride, int x1, int y1,
+                       int x2, int y2, uint32_t time_ms, bool swap_bytes) {
+    if (!dst || x1 < 0 || y1 < 0 || x2 > 239 || y2 > 239 ||
+        x1 > x2 || y1 > y2 || stride < (unsigned)(x2-x1+1)) return;
+    /* Unsigned time/index arithmetic wraps deliberately, including at uptime
+     * rollover. Q7 transforms use the C3 multiplier, with row-wise additions.
+     * Pixel sampling is anchored globally to 2x2 cells so five-line LVGL strips
+     * and arbitrary partial redraws produce exactly the same image. */
+    unsigned t = time_ms >> 4;
+    int zoom = 160 + half(wave[(t >> 2) & 255]);
+    int du = q7(wave[(t >> 1) & 255] * zoom);
+    int dv = q7(wave[((t >> 1) + 64) & 255] * zoom);
+    for (int y=y1; y<=y2; ++y) {
+        uint16_t *row = dst + (unsigned)(y-y1)*stride;
+        if (y > y1 && (y & 1)) {
+            for (int x=0; x<=x2-x1; ++x) row[x]=(row-stride)[x];
+            continue;
+        }
+        int yy=(y & ~1)-120, xx=(x1 & ~1)-120;
+        int u=xx*du-yy*dv, v=xx*dv+yy*du;
+        int radius=xx*xx+yy*yy;
+        for (int x=x1 & ~1; x<=x2; x+=2) {
+            uint16_t color=0;
+            if (radius <= 120*120) {
+                unsigned a=((unsigned)(u >> 7)+t*3) & 255;
+                unsigned b=((unsigned)(v >> 7)-t*2) & 255;
+                unsigned ring=((unsigned)radius >> 6)-t*4;
+                unsigned tile=((unsigned)(u >> 11) ^ (unsigned)(v >> 11)) & 1;
+                unsigned index=(unsigned)half(wave[a]+wave[b]+wave[ring & 255]);
+                index+=t*2+tile*48;
+                color=palette[index & 255];
+                if (swap_bytes) color=(uint16_t)((color << 8)|(color >> 8));
+            }
+            if (x >= x1) row[x-x1]=color;
+            if (x+1<=x2) row[x+1-x1]=color;
+            radius+=4*xx+4; xx+=2; u+=2*du; v+=2*dv;
+        }
+    }
+}
diff --git a/main/gui/round_expand.c b/main/gui/round_expand.c
new file mode 100644
index 0000000..7741f7a
--- /dev/null
+++ b/main/gui/round_expand.c
@@ -0,0 +1,73 @@
+#include "gui/round_expand.h"
+#include <string.h>
+#if defined(ESP_PLATFORM)
+#include "esp_attr.h"
+#define HOT IRAM_ATTR
+#else
+#define HOT
+#endif
+/* Keep both kernels for the device's explicit correctness/timing benchmark.
+ * The C compiler already emits paired word stores from these memcpy calls. */
+#if defined(__GNUC__) && !defined(__clang__)
+#define OPT(level) __attribute__((optimize(level)))
+#else
+#define OPT(level)
+#endif
+static __attribute__((always_inline)) inline void expand_c(void *dst,const uint8_t *packed,size_t n,const uint16_t pal[16]) {
+    uint8_t *out=dst;
+    if ((uintptr_t)dst & 3u) {
+        for(size_t i=0;i<n;i++) {
+            uint16_t hi=pal[packed[i]>>4],lo=pal[packed[i]&15];
+            memcpy(out,&hi,2);memcpy(out+2,&hi,2);
+            memcpy(out+4,&lo,2);memcpy(out+6,&lo,2);out+=8;
+        }
+        return;
+    }
+    out=__builtin_assume_aligned(dst,4);
+    for(size_t i=0;i<n;i++) {
+        uint32_t hi=pal[packed[i]>>4],lo=pal[packed[i]&15];
+        hi|=hi<<16;lo|=lo<<16;
+        memcpy(out,&hi,4);memcpy(out+4,&lo,4);out+=8;
+    }
+}
+#define C_KERNEL(name,placement,level) \
+    __attribute__((noinline)) OPT(level) void placement name(void *d,const uint8_t *s,size_t n,const uint16_t p[16]) {expand_c(d,s,n,p);}
+C_KERNEL(round_expand4_c,,"O3")
+C_KERNEL(round_expand4_os,,"Os")
+C_KERNEL(round_expand4_o2,,"O2")
+C_KERNEL(round_expand4_iram,HOT,"O3")
+__attribute__((noinline)) void HOT round_expand4_asm(void *dst,const uint8_t *packed,size_t n,const uint16_t pal[16]) {
+#if defined(__riscv) && __riscv_xlen == 32
+    if(!n) return;
+    if((uintptr_t)dst & 3u) {round_expand4_c(dst,packed,n,pal);return;}
+    /* RV32IMC only. No Zba/Zbb, no stack, no callee-saved register changes.
+     * Early-clobber prevents the changing pointers overlapping the palette. */
+    __asm__ volatile (
+        "1:\n\t"
+        "lbu t0,0(%[src])\n\t"
+        "srli t1,t0,4\n\t"
+        "andi t0,t0,15\n\t"
+        "slli t1,t1,1\n\t"
+        "add t1,%[pal],t1\n\t"
+        "lhu t1,0(t1)\n\t"
+        "slli t2,t1,16\n\t"
+        "or t1,t1,t2\n\t"
+        "sw t1,0(%[dst])\n\t"
+        "slli t0,t0,1\n\t"
+        "add t0,%[pal],t0\n\t"
+        "lhu t0,0(t0)\n\t"
+        "slli t2,t0,16\n\t"
+        "or t0,t0,t2\n\t"
+        "sw t0,4(%[dst])\n\t"
+        "addi %[src],%[src],1\n\t"
+        "addi %[dst],%[dst],8\n\t"
+        "addi %[count],%[count],-1\n\t"
+        "bnez %[count],1b\n\t"
+        : [dst] "+&r" (dst),[src] "+&r" (packed),[count] "+&r" (n)
+        : [pal] "r" (pal)
+        : "t0","t1","t2","memory"
+    );
+#else
+    round_expand4_c(dst,packed,n,pal);
+#endif
+}
diff --git a/main/gui/round_saver.c b/main/gui/round_saver.c
new file mode 100644
index 0000000..d3c68bb
--- /dev/null
+++ b/main/gui/round_saver.c
@@ -0,0 +1,106 @@
+#include "sdkconfig.h"
+#ifdef CONFIG_SUNTON_ESP32_2424S012
+#include "gui/round_saver.h"
+#include "gui/round_demo.h"
+#include "core/glog.h"
+#include "lvgl.h"
+#include "esp_timer.h"
+#include <stdatomic.h>
+
+#if LV_COLOR_DEPTH != 16
+#error Round saver requires the board RGB565 draw buffer
+#endif
+#define FRAME_MS 50u
+#define IDLE_MS 15000u
+static atomic_int pending;
+static round_demo_effect_t effect=ROUND_EFFECT_CREW;
+round_demo_effect_t round_saver_effect(void) {return effect;}
+static lv_obj_t *overlay;
+static const void *owner;
+static bool automatic=true, consume_release;
+static uint32_t phase_ms, last_frame_ms, frames, max_raster_us;
+static uint64_t raster_us;
+static uint32_t frame_raster_us, started_ms, stopped_ms;
+
+void round_saver_request(round_saver_command_t command) {
+    atomic_store(&pending, command);
+}
+static void stop(void) {
+    if (overlay) {
+        stopped_ms=(uint32_t)(esp_timer_get_time()/1000);
+        lv_obj_del(overlay); overlay=NULL;
+    }
+    owner=NULL;
+}
+static void draw(lv_event_t *e) {
+    if (lv_event_get_code(e)!=LV_EVENT_DRAW_MAIN) return;
+    lv_draw_ctx_t *ctx=lv_event_get_draw_ctx(e);
+    lv_area_t a;
+    if (!_lv_area_intersect(&a,ctx->clip_area,ctx->buf_area)) return;
+    lv_area_t bounds={0,0,239,239};
+    if (!_lv_area_intersect(&a,&a,&bounds)) return;
+    unsigned stride=lv_area_get_width(ctx->buf_area);
+    lv_color_t *pixels=ctx->buf;
+    pixels+=(a.y1-ctx->buf_area->y1)*stride+a.x1-ctx->buf_area->x1;
+    int64_t begin=esp_timer_get_time();
+    round_demo_render_effect(effect,(uint16_t *)pixels,stride,a.x1,a.y1,a.x2,a.y2,phase_ms,LV_COLOR_16_SWAP);
+    frame_raster_us+=(uint32_t)(esp_timer_get_time()-begin);
+    if (a.y2==239 && a.x2==239) {
+        ++frames; raster_us+=frame_raster_us;
+        if(frame_raster_us>max_raster_us) max_raster_us=frame_raster_us;
+        frame_raster_us=0;
+    }
+}
+static void start(const void *view,uint32_t now) {
+    if (overlay) return;
+    overlay=lv_obj_create(lv_layer_top());
+    lv_obj_remove_style_all(overlay);
+    lv_obj_set_pos(overlay,0,0); lv_obj_set_size(overlay,240,240);
+    lv_obj_clear_flag(overlay,LV_OBJ_FLAG_SCROLLABLE|LV_OBJ_FLAG_CLICKABLE);
+    /* Opaque square lets LVGL skip covered screens. The physical bezel masks
+     * corners; no expensive per-pixel LVGL rounding or offscreen layer. */
+    lv_obj_set_style_bg_color(overlay,lv_color_black(),0);
+    lv_obj_set_style_bg_opa(overlay,LV_OPA_COVER,0);
+    lv_obj_add_event_cb(overlay,draw,LV_EVENT_DRAW_MAIN,NULL);
+    owner=view; phase_ms=now; last_frame_ms=now; started_ms=now;
+    frames=max_raster_us=frame_raster_us=0; raster_us=0;
+}
+bool round_saver_wake(bool touch,bool released) {
+    if (overlay) {
+        stop(); consume_release=touch && !released;
+        return true;
+    }
+    if (consume_release && touch) {
+        if (released) consume_release=false;
+        return true;
+    }
+    return false;
+}
+void round_saver_tick(const void *view,bool home,bool visible,bool reduced_motion,uint32_t idle_ms) {
+    uint32_t now=(uint32_t)(esp_timer_get_time()/1000);
+    int command=atomic_exchange(&pending,0);
+    if (command==ROUND_SAVER_NEON || command==ROUND_SAVER_CREW) {
+        stop(); effect=command==ROUND_SAVER_CREW?ROUND_EFFECT_CREW:ROUND_EFFECT_NEON;
+        command=ROUND_SAVER_ON;
+    }
+    if (command==ROUND_SAVER_OFF) {automatic=false;stop();}
+    if (command==ROUND_SAVER_AUTO) automatic=true;
+    if (overlay && (view!=owner || !visible)) stop();
+    if (visible && !overlay &&
+        (command==ROUND_SAVER_ON || (automatic && home && !reduced_motion && idle_ms>=IDLE_MS))) {
+        start(view,now);
+    }
+    if (overlay && (uint32_t)(now-last_frame_ms)>=FRAME_MS) {
+        last_frame_ms=now; phase_ms=now; lv_obj_invalidate(overlay);
+    }
+}
+void round_saver_status(void) {
+    uint32_t end=overlay?(uint32_t)(esp_timer_get_time()/1000):stopped_ms;
+    uint32_t elapsed=started_ms?end-started_ms:0;
+    unsigned fps10=elapsed?(unsigned)((uint64_t)frames*10000/elapsed):0;
+    glog("Saver: %s (%s); auto=%s (15s home idle); frames=%lu elapsed=%lums fps=%u.%u raster_avg=%luus raster_max=%luus\n",
+         overlay?"active":"stopped",effect==ROUND_EFFECT_CREW?"Copper Dream":"Neon Vortex",automatic?"on":"off",(unsigned long)frames,
+         (unsigned long)elapsed,fps10/10,fps10%10,
+         (unsigned long)(frames?raster_us/frames:0),(unsigned long)max_raster_us);
+}
