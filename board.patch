+#include "gui/round_demo.h"
+/* Read-only tables stay in flash, not the scarce internal data heap. */
+#define wave round_demo_wave
+const int8_t round_demo_wave[256] = {
+    0,3,6,9,12,16,19,22,25,28,31,34,37,40,43,46,
+    49,51,54,57,60,63,65,68,71,73,76,78,81,83,85,88,
