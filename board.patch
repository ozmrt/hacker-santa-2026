diff --git a/main/scans/rf_watch.c b/main/scans/rf_watch.c
new file mode 100644
index 0000000..7ec9c24
--- /dev/null
+++ b/main/scans/rf_watch.c
@@ -0,0 +1,113 @@
+#include "scans/rf_watch.h"
+#include <string.h>
+
+static int hex_digit(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static bool parse_mac(const char *text, uint8_t out[6]) {
+    if (!text || strlen(text) != 17) return false;
+    for (unsigned i = 0; i < 6; i++) {
+        int high = hex_digit(text[i * 3]);
+        int low = hex_digit(text[i * 3 + 1]);
+        if (high < 0 || low < 0 || (i < 5 && text[i * 3 + 2] != ':')) return false;
+        out[i] = (uint8_t)((high << 4) | low);
+    }
+    return true;
+}
+
+static bool printable(const char *text, size_t max_len) {
+    if (!text) return false;
+    size_t n = 0;
+    while (n <= max_len && text[n] != '\0') n++;
+    if (n == 0 || n > max_len) return false;
+    for (size_t i = 0; i < n; i++)
+        if ((unsigned char)text[i] < 0x20 || (unsigned char)text[i] > 0x7e)
+            return false;
+    return true;
+}
+
+void rf_watch_init(rf_watch_table_t *table) {
+    memset(table, 0, sizeof(*table));
+    table->version = 1;
+}
+
+bool rf_watch_validate(const rf_watch_table_t *table) {
+    if (!table || table->version != 1 || table->count > RF_WATCH_MAX_RULES)
+        return false;
+    for (unsigned i = 0; i < table->count; i++) {
+        const rf_watch_rule_t *r = &table->rules[i];
+        switch (r->kind) {
+        case RF_WATCH_AP_SSID:
+            if (!printable(r->text, 32)) return false;
+            break;
+        case RF_WATCH_BLE_NAME:
+            /* Upstream's advertiser result retains at most 23 name bytes. */
+            if (!printable(r->text, 23)) return false;
+            break;
+        case RF_WATCH_AP_BSSID:
+        case RF_WATCH_BLE_ADDR:
+            if (r->text[0] != '\0') return false;
+            break;
+        default:
+            return false;
+        }
+    }
+    return true;
+}
+
+bool rf_watch_add(rf_watch_table_t *table, rf_watch_kind_t kind, const char *value) {
+    if (!rf_watch_validate(table) || !value || table->count >= RF_WATCH_MAX_RULES)
+        return false;
+    rf_watch_rule_t rule = {.kind = (uint8_t)kind};
+    if (kind == RF_WATCH_AP_SSID || kind == RF_WATCH_BLE_NAME) {
+        size_t limit = kind == RF_WATCH_AP_SSID ? 32 : 23;
+        if (!printable(value, limit)) return false;
+        memcpy(rule.text, value, strlen(value) + 1);
+    } else if (kind == RF_WATCH_AP_BSSID || kind == RF_WATCH_BLE_ADDR) {
+        if (!parse_mac(value, rule.mac)) return false;
+    } else {
+        return false;
+    }
+    for (unsigned i = 0; i < table->count; i++)
+        if (memcmp(&table->rules[i], &rule, sizeof(rule)) == 0) return false;
+    table->rules[table->count++] = rule;
+    return true;
+}
+
+bool rf_watch_remove(rf_watch_table_t *table, unsigned index) {
+    if (!rf_watch_validate(table) || index >= table->count) return false;
+    for (unsigned i = index; i + 1 < table->count; i++)
+        table->rules[i] = table->rules[i + 1];
+    memset(&table->rules[--table->count], 0, sizeof(table->rules[0]));
+    return true;
+}
+
+bool rf_watch_ap_matches(const rf_watch_rule_t *r, const uint8_t ssid[33],
+                         const uint8_t bssid[6]) {
+    if (!r) return false;
+    if (r->kind == RF_WATCH_AP_BSSID) return bssid && memcmp(r->mac, bssid, 6) == 0;
+    if (r->kind != RF_WATCH_AP_SSID || !ssid) return false;
+    size_t len = strlen(r->text);
+    return memcmp(r->text, ssid, len) == 0 && (len == 32 || ssid[len] == '\0');
+}
+
+bool rf_watch_ble_matches(const rf_watch_rule_t *r, const char *name,
+                          const uint8_t addr[6]) {
+    if (!r) return false;
+    if (r->kind == RF_WATCH_BLE_ADDR) return addr && memcmp(r->mac, addr, 6) == 0;
+    return r->kind == RF_WATCH_BLE_NAME && name && strcmp(r->text, name) == 0;
+}
+
+const char *rf_watch_kind_name(rf_watch_kind_t kind) {
+    switch (kind) {
+    case RF_WATCH_AP_SSID: return "AP SSID";
+    case RF_WATCH_AP_BSSID: return "AP BSSID";
+    case RF_WATCH_BLE_NAME: return "BLE name";
+    case RF_WATCH_BLE_ADDR: return "BLE address";
+    default: return "invalid";
+    }
+}
