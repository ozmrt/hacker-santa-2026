+    if (!sessionStorage.getItem('ghost_recon_safety_seen')) {
+      sessionStorage.setItem('ghost_recon_safety_seen', '1');
+      setTimeout(() => reconSafetyPopup(false), 450);
+    }
+  } catch (_) { /* private browsing may block session storage */ }
+}
