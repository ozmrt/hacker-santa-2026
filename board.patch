new file mode 100644
index 0000000..d6de835
--- /dev/null
+++ b/components/lvgl_esp32_drivers/lvgl_touch/cst816_frame.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* CST816D/S registers 0x01..0x06, as used by ESP32-2424S012. A release
+ * can carry stale coordinates; reserved events and out-of-range data must
+ * never become a new contact. Keep this independent of LVGL for host tests. */
+static inline bool cst816_contact(const uint8_t frame[6], uint16_t *x, uint16_t *y) {
+    const uint8_t fingers = frame[1] & 0x0f;
+    const uint8_t event = frame[2] >> 6;
+    const uint16_t px = ((uint16_t)(frame[2] & 0x0f) << 8) | frame[3];
+    const uint16_t py = ((uint16_t)(frame[4] & 0x0f) << 8) | frame[5];
+    if (fingers != 1 || (event != 0 && event != 2) || px >= 240 || py >= 240) {
+        return false;
+    }
+    *x = px;
+    *y = py;
+    return true;
+}
