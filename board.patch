diff --git a/main/managers/lab_poc.c b/main/managers/lab_poc.c
new file mode 100644
index 0000000..af9062e
--- /dev/null
+++ b/main/managers/lab_poc.c
@@ -0,0 +1,22 @@
+#include "managers/lab_poc.h"
+#include <string.h>
+
+lab_poc_fixture_t lab_poc_parse_form(const char *body, size_t length) {
+    if (!body || length == 0 || length > 64 || memchr(body, '\0', length))
+        return LAB_POC_INVALID;
+    static const char paypal[] = "fixture=paypal-sandbox";
+    static const char card[] = "fixture=card-test-token";
+    if (length == sizeof(paypal) - 1 && memcmp(body, paypal, length) == 0)
+        return LAB_POC_PAYPAL_SANDBOX;
+    if (length == sizeof(card) - 1 && memcmp(body, card, length) == 0)
+        return LAB_POC_CARD_TEST_TOKEN;
+    return LAB_POC_INVALID;
+}
+
+const char *lab_poc_fixture_name(lab_poc_fixture_t fixture) {
+    switch (fixture) {
+    case LAB_POC_PAYPAL_SANDBOX: return "paypal-sandbox";
+    case LAB_POC_CARD_TEST_TOKEN: return "card-test-token";
+    default: return "invalid";
+    }
+}
