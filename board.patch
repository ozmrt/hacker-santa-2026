diff --git a/main/gui/orbital_game.c b/main/gui/orbital_game.c
new file mode 100644
index 0000000..0c7bc86
--- /dev/null
+++ b/main/gui/orbital_game.c
@@ -0,0 +1,85 @@
+#include "gui/orbital_game.h"
+#include "gui/round_demo.h"
+#include <string.h>
+#include <limits.h>
+static const uint8_t atan_octant[65]={0,3,5,8,10,13,15,18,20,23,25,28,30,33,35,38,40,42,45,47,49,52,54,56,58,61,63,65,67,69,71,74,76,78,80,82,84,85,87,89,91,93,95,96,98,100,102,103,105,106,108,110,111,113,114,116,117,119,120,121,123,124,125,127,128};
+static int abs_i(int v) {return v<0?-v:v;}
+static int delta(unsigned a,unsigned b) {return (int)((a-b+512)&1023)-512;}
+static uint32_t random_next(orbital_game_t *g) {
+    uint32_t x=g->rng;x^=x<<13;x^=x>>17;x^=x<<5;return g->rng=x;
+}
+static int sine(unsigned angle) {
+    angle&=1023;unsigned i=angle>>2,frac=angle&3;
+    int a=round_demo_wave[i],b=round_demo_wave[(i+1)&255];
+    return (a*4+(b-a)*(int)frac)*64; /* Interpolated Q15, bounded +/-32512. */
+}
+void orbital_point(uint16_t a,uint16_t r,int *x,int *y) {
+    /* Radius<=112px keeps Q8*Q15 products within signed 32 bits. */
+    *x=120+((int)r*sine(a+256)>>23);
+    *y=120+((int)r*sine(a)>>23);
+}
+uint16_t orbital_touch_angle(int x,int y) {
+    int dx=x-120,dy=y-120,ax=abs_i(dx),ay=abs_i(dy);
+    if(!ax && !ay) return 0;
+    unsigned a=ax>=ay?atan_octant[(unsigned)(ay*64/ax)]:256-atan_octant[(unsigned)(ax*64/ay)];
+    if(dx<0) a=512-a;
+    if(dy<0) a=1024-a;
+    return (uint16_t)(a&1023);
+}
+void orbital_game_init(orbital_game_t *g,uint32_t seed) {
+    memset(g,0,sizeof(*g));g->rng=seed?seed:1;g->lives=3;g->level=1;
+    g->angle=g->target=768;g->spawn_timer=20;
+}
+static void burst(orbital_game_t *g,const orbit_body_t *body) {
+    for(unsigned i=0;i<ORBIT_BURSTS;i++) if(!g->bursts[i].active) {
+        g->bursts[i]=*body;g->bursts[i].active=10;return;
+    }
+}
+void orbital_game_step(orbital_game_t *g) {
+    if(!g->lives) return;
+    ++g->ticks;
+    int d=delta(g->target,g->angle),m=abs_i(d);
+    int turn=(m*3+7)>>3;if(turn>18)turn=18;
+    g->angle=(uint16_t)((g->angle+(d<0?-turn:turn))&1023);
+    for(unsigned i=0;i<ORBIT_BURSTS;i++) if(g->bursts[i].active) --g->bursts[i].active;
+    if(g->fire_timer) --g->fire_timer;
+    else {
+        for(unsigned i=0;i<ORBIT_SHOTS;i++) if(!g->shots[i].active) {
+            g->shots[i]=(orbit_body_t){g->angle,91*256,1,0};break;
+        }
+        g->fire_timer=10;
+    }
+    if(g->spawn_timer) --g->spawn_timer;
+    else {
+        for(unsigned i=0;i<ORBIT_ENEMIES;i++) if(!g->enemies[i].active) {
+            uint32_t r=random_next(g);
+            g->enemies[i]=(orbit_body_t){(uint16_t)(r&1023),18*256,1,(uint8_t)((r>>10)&1)};break;
+        }
+        g->spawn_timer=(uint16_t)(35-g->level);
+    }
+    for(unsigned i=0;i<ORBIT_SHOTS;i++) if(g->shots[i].active) {
+        if(g->shots[i].radius<=9*256) g->shots[i].active=0;
+        else g->shots[i].radius-=3*256;
+    }
+    for(unsigned i=0;i<ORBIT_ENEMIES;i++) {
+        orbit_body_t *e=&g->enemies[i];if(!e->active)continue;
+        e->radius+=(uint16_t)(54+g->level*6);
+        e->angle=(uint16_t)((e->angle+(e->kind?1:-1))&1023);
+        bool hit=false;
+        for(unsigned j=0;j<ORBIT_SHOTS;j++) {
+            orbit_body_t *b=&g->shots[j];
+            if(b->active && abs_i((int)b->radius-e->radius)<6*256 &&
+               abs_i(delta(b->angle,e->angle))*(e->radius>>8)<1400) {
+                hit=true;b->active=0;break;
+            }
+        }
+        if(hit) {
+            burst(g,e);e->active=0;
+            if(g->score<=UINT32_MAX-10)g->score+=10;
+            unsigned level=1+g->score/100;g->level=(uint8_t)(level>15?15:level);
+        } else if(e->radius>=92*256 &&
+                  abs_i(delta(e->angle,g->angle))<22) {
+            burst(g,e);e->active=0;if(g->lives)--g->lives;
+        } else if(e->radius>110*256) e->active=0;
+    }
+}
diff --git a/main/gui/round_crew.c b/main/gui/round_crew.c
new file mode 100644
index 0000000..8329ed5
--- /dev/null
+++ b/main/gui/round_crew.c
@@ -0,0 +1,90 @@
+#include "gui/round_demo.h"
+#include "gui/round_expand.h"
+#include <string.h>
+
+/* Original procedural scene inspired by early PC demos: copper bars, a shaded
+ * sine-twister, perspective checker floor, parallax stars and a sine trace.
+ * Not an asset/music/code reproduction of a Future Crew production. */
+static const uint16_t colors[16]={
+    0x0001,0x0805,0x100a,0x1810,0x2017,0x381e,0x581f,0x781e,
+    0xa01a,0xc815,0xe810,0xfa09,0xfbe5,0xfd87,0xff0c,0xffff
+};
+static int wave(unsigned p) {return round_demo_wave[p&255];}
+static int magnitude(int v) {return v<0?-v:v;}
+
+static __attribute__((always_inline)) inline void crew_render(uint16_t *dst,unsigned stride,int x1,int y1,int x2,int y2,
+                       uint32_t ms,bool swap_bytes) {
+    if(!dst || x1<0 || y1<0 || x2>239 || y2>239 || x1>x2 || y1>y2 ||
+       stride<(unsigned)(x2-x1+1)) return;
+    unsigned t=ms>>4;
+    int horizon=106+(wave(t>>2)>>3);
+    int spin_x=wave((t>>2)+64),spin_y=wave(t>>2);
+    /* Bounded stack scratch, never a stored image: 60 packed bytes + 32 palette. */
+    uint8_t packed[60];
+    uint16_t pal[16];
+    for(unsigned i=0;i<16;i++) {
+        uint16_t c=colors[i];
+        pal[i]=swap_bytes?(uint16_t)((c<<8)|(c>>8)):c;
+    }
+    for(int y=y1;y<=y2;y++) {
+        uint16_t *row=dst+(unsigned)(y-y1)*stride;
+        if(y>y1 && (y&1)) {memcpy(row,row-stride,(unsigned)(x2-x1+1)*2);continue;}
+        int yy=y&~1;
+        int perspective=8192/(magnitude(yy-horizon)+12); /* Once per logical row. */
+        int du=(spin_x*perspective)>>7,dv=(spin_y*perspective)>>7;
+        int u=-120*du+(int)((t*128)&65535),v=-120*dv+(perspective<<6)+(int)((t*96)&65535);
+        int center=120+(wave((unsigned)yy*2+t*3)>>1);
+        int width=18+((wave((unsigned)yy+t*2+64)+128)>>3);
+        int shade_scale=1536/width; /* Row reciprocal, not a per-pixel DIV. */
+        int bar=0;
+        for(unsigned k=0;k<3;k++) {
+            int by=24+((wave(t*2+k*85)+128)*72>>8);
+            int distance=magnitude(yy-by);
+            if(distance<8 && yy<horizon) bar=14-distance;
+        }
+        for(int x=0;x<240;x+=2) {
+            unsigned index=0;
+            if(yy>=horizon) {
+                unsigned checker=((unsigned)(u>>12)^(unsigned)(v>>12))&1;
+                unsigned grid=(((unsigned)u&4095)<128)||(((unsigned)v&4095)<128);
+                index=1+checker*2+grid*2;
+            } else {
+                index=(unsigned)bar;
+                unsigned sx=(unsigned)x+(t>>1);
+                unsigned seed=(sx>>4)*73+((unsigned)yy>>4)*151;
+                if((sx&15)==((seed^(seed>>3))&14) &&
+                    ((unsigned)yy&15)==((seed>>3)&14)) index=15;
+            }
+            int dx=x-center;
+            if(magnitude(dx)<width) index=(unsigned)(9+((dx*shade_scale)>>8));
+            if(yy>184 && magnitude(yy-210-(wave((unsigned)x*2+t*3)>>3))<2) index=15;
+            unsigned i=(unsigned)x>>1;
+            if(i&1) packed[i>>1]|=(uint8_t)index;
+            else packed[i>>1]=(uint8_t)(index<<4);
+            u+=du*2;v+=dv*2;
+        }
+        if(x1==0 && x2==239) {
+            /* Device measurement: C-IRAM 220us vs ASM-IRAM 304us /32 rows. */
+            round_expand4_iram(row,packed,60,pal);
+        } else {
+            for(int x=x1;x<=x2;x++) {
+                unsigned i=(unsigned)x>>1;
+                unsigned index=(i&1)?packed[i>>1]&15:packed[i>>1]>>4;
+                row[x-x1]=pal[index];
+            }
+        }
+    }
+}
+
+#if defined(__GNUC__) && !defined(__clang__)
+#define CREW_OPT(level) __attribute__((optimize(level)))
+#else
+#define CREW_OPT(level)
+#endif
+#define CREW_KERNEL(name,level) \
+    CREW_OPT(level) void name(uint16_t *d,unsigned s,int x1,int y1,int x2,int y2,uint32_t t,bool swap) {crew_render(d,s,x1,y1,x2,y2,t,swap);}
+CREW_KERNEL(round_crew_render,"O3")
+#if ROUND_CREW_PROFILE
+CREW_KERNEL(round_crew_render_os,"Os")
+CREW_KERNEL(round_crew_render_o2,"O2")
+#endif
