 }
+
+#ifdef CONFIG_SUNTON_ESP32_2424S012
+#include "gui/round_saver.h"
+#include "gui/round_demo.h"
+#include "gui/round_expand.h"
+#include "esp_timer.h"
+static void saver_kernel_bench(void) {
+    uint8_t packed[256];
+    uint16_t palette[16];
+    for(unsigned i=0;i<256;i++) packed[i]=(uint8_t)i;
+    for(unsigned i=0;i<16;i++) palette[i]=(uint16_t)(i*4369);
+    uint32_t *reference=malloc(256*8),*output=malloc(256*8+4);
+    if(!reference || !output) {free(reference);free(output);glog("Kernel benchmark: no memory\n");return;}
+    round_expand4_c(reference,packed,256,palette);
+    void (*kernels[])(void *,const uint8_t *,size_t,const uint16_t *)={round_expand4_os,round_expand4_o2,round_expand4_c,round_expand4_iram,round_expand4_asm};
+    const char *names[]={"C-Os-flash","C-O2-flash","C-O3-flash","C-O3-IRAM","ASM-IRAM"};
+    for(unsigned k=0;k<5;k++) {
+        uint64_t total=0; uint32_t best=UINT32_MAX;
+        bool match=true;
+        for(unsigned run=0;run<64;run++) {
+            int64_t start=esp_timer_get_time();
+            for(unsigned row=0;row<32;row++) kernels[k](output,packed,60,palette);
+            uint32_t elapsed=(uint32_t)(esp_timer_get_time()-start);
+            total+=elapsed;if(elapsed<best)best=elapsed;
+            if(memcmp(output,reference,60*8)!=0) match=false;
+            vTaskDelay(1);
+        }
+        /* All 256 byte patterns must also match, not only the timed prefix. */
+        kernels[k](output,packed,256,palette);
+        match=match && !memcmp(output,reference,256*8);
+        for(unsigned offset=1;offset<4;offset++) {
+            kernels[k]((uint8_t *)output+offset,packed,256,palette);
+            match=match && !memcmp((uint8_t *)output+offset,reference,256*8);
+        }
+        glog("expand4 %s: match=%s avg=%luus best=%luus /32 scanlines (240px each)\n",names[k],match?"yes":"NO",(unsigned long)(total/64),(unsigned long)best);
+    }
+    free(output);free(reference);
+}
+static void saver_status_cb(void *arg) {(void)arg;round_saver_status();}
+void handle_saver_cmd(int argc,char **argv) {
+    if(argc==2 && strcmp(argv[1],"kernels")==0) {saver_kernel_bench();return;}
+    if (argc>=2 && strcmp(argv[1],"bench")==0) {
+        round_demo_effect_t effect=(argc>=3 && strcmp(argv[2],"crew")==0)?ROUND_EFFECT_CREW:ROUND_EFFECT_NEON;
+        /* Explicit diagnostic only: transient 2,400-byte strip, never a frame.
+         * Kept off the UI task; normal rendering can preempt this workload. */
+        uint16_t *strip=malloc(240*5*sizeof(*strip));
+        if (!strip) {glog("Saver benchmark: no memory for strip\n");return;}
+        typedef void (*raster_fn)(uint16_t *,unsigned,int,int,int,int,uint32_t,bool);
+        raster_fn kernels[3]={effect==ROUND_EFFECT_CREW?round_crew_render:round_demo_render};
+        const char *names[3]={effect==ROUND_EFFECT_CREW?"crew-O3":"neon-Os"};
+        unsigned count=1;
+#if ROUND_CREW_PROFILE
+        if(effect==ROUND_EFFECT_CREW) {
+            kernels[1]=round_crew_render_os;kernels[2]=round_crew_render_o2;
+            names[1]="crew-Os";names[2]="crew-O2";count=3;
+        }
+#endif
+        for(unsigned k=0;k<count;k++) {
+            uint32_t check=0;
+            int64_t begin=esp_timer_get_time();
+            for(unsigned frame=0;frame<32;frame++) {
+                for(int y=0;y<240;y+=5) {
+                    kernels[k](strip,240,0,y,239,y+4,frame*50,LV_COLOR_16_SWAP);
+                    check+=strip[frame];
+                }
+                vTaskDelay(1);
+            }
+            unsigned long elapsed=(unsigned long)(esp_timer_get_time()-begin);
+            glog("Saver %s raster bench: 32 frames, %luus total, %luus/frame (includes yields/scheduling), checksum=%lu; excludes SPI\n",
+                 names[k],elapsed,elapsed/32,(unsigned long)check);
+        }
+        free(strip);
+        return;
+    }
+    if (argc==2 && strcmp(argv[1],"status")==0) {
+        display_manager_run_on_lvgl(saver_status_cb,NULL);
+        return;
+    }
+    if (argc==2) {
+        if (strcmp(argv[1],"on")==0) round_saver_request(ROUND_SAVER_ON);
+        else if (strcmp(argv[1],"off")==0) round_saver_request(ROUND_SAVER_OFF);
+        else if (strcmp(argv[1],"crew")==0) round_saver_request(ROUND_SAVER_CREW);
+        else if (strcmp(argv[1],"neon")==0) round_saver_request(ROUND_SAVER_NEON);
+        else if (strcmp(argv[1],"auto")==0) round_saver_request(ROUND_SAVER_AUTO);
+        else {glog("Usage: saver <on|off|auto|crew|neon|status|bench [crew|neon]|kernels>\n");return;}
+        glog("Saver request queued; lock and display timeout take precedence\n");
+        return;
+    }
+    glog("Usage: saver <on|off|auto|crew|neon|status|bench [crew|neon]|kernels>\n");
+}
+#endif
