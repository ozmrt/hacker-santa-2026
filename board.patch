+}
+function buildRecon() {
+  reconLoad();
+  reconRender();
+  $('recon-scan-ap')?.addEventListener('click', () => runCommand('scanap'));
+  $('recon-ble-start')?.addEventListener('click', () => runCommand('blescan -adv'));
+  $('recon-ble-stop')?.addEventListener('click', () => runCommand('blescan -s'));
+  $('recon-collect')?.addEventListener('click', reconCollect);
+  $('recon-export-csv')?.addEventListener('click', () => reconDownload('csv'));
+  $('recon-export-json')?.addEventListener('click', () => reconDownload('json'));
