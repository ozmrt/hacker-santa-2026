+    size_t len = strlen(ssid);
+    if (argc > 2 || len < 5 || len > 31 || strncmp(ssid, "LAB-", 4) != 0) {
+        glog("Usage: labportal [LAB-SSID] (5-31 characters)\n");
+        return;
+    }
+    for (size_t i = 4; i < len; i++) {
+        char c = ssid[i];
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+              (c >= '0' && c <= '9') || c == '-' || c == '_')) {
+            glog("Lab SSID may contain only letters, digits, hyphen and underscore\n");
+            return;
+        }
+    }
+    esp_err_t err = wifi_manager_start_evil_portal("lab", NULL, "", ssid, "lab.local");
+    glog(err == ESP_OK ? "Lab portal started: %s\n" : "Lab portal start failed: %s\n",
+         err == ESP_OK ? ssid : esp_err_to_name(err));
+}
+#endif
