+ * Width changes leave row heights and vertical scroll positions unchanged. */
+static inline void round_list_fit_event(lv_event_t *event) {
+    lv_obj_t *list = lv_event_get_target(event);
+    lv_area_t viewport;
+    lv_obj_get_coords(list, &viewport);
+    int center = (viewport.x1 + viewport.x2 + 1) / 2;
+    int offset = center - ROUND_CENTER;
+    if (offset < 0) offset = -offset;
+    int max_width = lv_obj_get_content_width(list);
+    uint32_t count = lv_obj_get_child_cnt(list);
+    for (uint32_t i = 0; i < count; ++i) {
+        lv_obj_t *item = lv_obj_get_child(list, (int32_t)i);
+        if (lv_obj_has_flag_any(item, LV_OBJ_FLAG_HIDDEN | LV_OBJ_FLAG_IGNORE_LAYOUT)) continue;
+        lv_area_t area;
+        lv_obj_get_coords(item, &area);
+        int top = area.y1 > viewport.y1 ? area.y1 : viewport.y1;
+        int bottom = area.y2 < viewport.y2 ? area.y2 : viewport.y2;
+        if (top > bottom) continue;
+        int width = round_band_width(top, bottom) - 2 * offset;
+        if (width > max_width) width = max_width;
+        if (width < 1) width = 1;
+        if (lv_obj_get_width(item) != width) lv_obj_set_width(item, width);
+    }
+}
+
+static inline void round_list_enable(lv_obj_t *list) {
+    lv_obj_set_flex_align(list, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_scrollbar_mode(list, LV_SCROLLBAR_MODE_OFF);
+    lv_obj_clear_flag(list, LV_OBJ_FLAG_SCROLL_ELASTIC);
+    lv_obj_add_event_cb(list, round_list_fit_event, LV_EVENT_SCROLL, NULL);
+    lv_obj_add_event_cb(list, round_list_fit_event, LV_EVENT_LAYOUT_CHANGED, NULL);
+    lv_obj_add_event_cb(list, round_list_fit_event, LV_EVENT_SIZE_CHANGED, NULL);
+}
