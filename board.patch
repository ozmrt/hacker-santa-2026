+#ifdef CONFIG_SUNTON_ESP32_2424S012
+/* Wi-Fi SSIDs and BLE names are untrusted bytes. Export printable ASCII only,
+ * then escape JSON syntax. The browser renders these fields with textContent. */
+static void recon_json_text(const uint8_t *src, size_t len, char *out, size_t cap) {
+    size_t used = 0;
+    for (size_t i = 0; i < len && src[i] && used + 2 < cap; ++i) {
+        uint8_t c = src[i];
+        if (c == '"' || c == '\\') out[used++] = '\\';
+        out[used++] = c >= 0x20 && c <= 0x7e ? (char)c : '?';
+    }
+    out[used] = '\0';
+}
+
+static esp_err_t api_recon_handler(httpd_req_t *req) {
+    WEBUI_GUARD_OR_RETURN(req);
+    if (ap_scan_is_running() || advertiser_scan_is_active()) {
+        httpd_resp_set_status(req, "409 Conflict");
+        httpd_resp_set_type(req, "application/json");
+        return httpd_resp_sendstr(req, "{\"error\":\"Stop scans before collecting a snapshot\"}");
+    }
+    httpd_resp_set_type(req, "application/json");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    httpd_resp_set_hdr(req, "X-Content-Type-Options", "nosniff");
+    uint16_t ap_count = 0;
+    wifi_ap_record_t *aps = NULL;
+    ap_scan_get_results(&ap_count, &aps);
+    int ble_count = advertiser_scan_get_count();
+    char line[480], name[256], mac[18];
+    int n = snprintf(line, sizeof(line),
+                     "{\"ap_count\":%u,\"ble_count\":%d,\"ap_truncated\":%s,\"items\":[",
+                     (unsigned)ap_count, ble_count,
+                     ap_scan_results_truncated() ? "true" : "false");
+    if (n < 0 || n >= sizeof(line) ||
+        httpd_resp_send_chunk(req, line, n) != ESP_OK) return ESP_FAIL;
+    bool first = true;
+    for (unsigned i = 0; aps && i < ap_count; ++i) {
+        recon_json_text(aps[i].ssid, sizeof(aps[i].ssid), name, sizeof(name));
+        snprintf(mac, sizeof(mac), "%02X:%02X:%02X:%02X:%02X:%02X",
+                 aps[i].bssid[0], aps[i].bssid[1], aps[i].bssid[2],
+                 aps[i].bssid[3], aps[i].bssid[4], aps[i].bssid[5]);
+        n = snprintf(line, sizeof(line),
+                     "%s{\"radio\":\"wifi\",\"index\":%u,\"address\":\"%s\",\"name\":\"%s\",\"rssi\":%d,\"channel\":%u}",
+                     first ? "" : ",", i, mac, name, (int)aps[i].rssi,
+                     (unsigned)aps[i].primary);
+        if (n < 0 || n >= sizeof(line) ||
+            httpd_resp_send_chunk(req, line, n) != ESP_OK) return ESP_FAIL;
+        first = false;
+    }
+    for (int i = 0; i < ble_count; ++i) {
+        AdvertiserDeviceInfo dev;
+        if (advertiser_scan_get_device(i, &dev) != 0) continue;
+        recon_json_text((const uint8_t *)dev.name, sizeof(dev.name), name, sizeof(name));
+        snprintf(mac, sizeof(mac), "%02X:%02X:%02X:%02X:%02X:%02X",
+                 dev.mac[0], dev.mac[1], dev.mac[2],
+                 dev.mac[3], dev.mac[4], dev.mac[5]);
+        n = snprintf(line, sizeof(line),
+                     "%s{\"radio\":\"ble\",\"index\":%d,\"address\":\"%s\",\"name\":\"%s\",\"rssi\":%d,\"seen\":%lu}",
+                     first ? "" : ",", i, mac, name, (int)dev.rssi,
+                     (unsigned long)dev.seen_count);
+        if (n < 0 || n >= sizeof(line) ||
+            httpd_resp_send_chunk(req, line, n) != ESP_OK) return ESP_FAIL;
+        first = false;
+    }
+    return httpd_resp_send_chunk(req, "]}", 2) == ESP_OK ?
+           httpd_resp_send_chunk(req, NULL, 0) : ESP_FAIL;
+}
+#endif
