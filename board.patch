 void handle_start_portal(int argc, char **argv) {
     if (argc < 3 || argc > 4) { // Accept 3 or 4 arguments
         glog("Usage: %s <FilePath> <AP_SSID> [PSK]\n", argv[0]);
diff --git a/main/core/commands/cmd_rfwatch.c b/main/core/commands/cmd_rfwatch.c
new file mode 100644
index 0000000..2a49e74
--- /dev/null
+++ b/main/core/commands/cmd_rfwatch.c
@@ -0,0 +1,272 @@
+#include "sdkconfig.h"
+#ifdef CONFIG_SUNTON_ESP32_2424S012
+
+#include "core/commands.h"
+#include "core/glog.h"
+#include "scans/rf_watch.h"
+#include "scans/wifi/ap_scan.h"
+#include "scans/ble/advertiser_scan.h"
+#include "scans/ble/device_detect_scan.h"
+#include "managers/wifi_manager.h"
+#include "esp_heap_caps.h"
+#include "nvs.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static rf_watch_table_t s_rules;
+static bool s_loaded;
+static enum { FOX_NONE, FOX_AP, FOX_BLE } s_fox_source;
+
+static int fox_hex(char c) {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+static bool parse_address(const char *value, uint8_t out[6]) {
+    if (!value || strlen(value) != 17) return false;
+    for (unsigned i = 0; i < 6; ++i) {
+        int high = fox_hex(value[i * 3]);
+        int low = fox_hex(value[i * 3 + 1]);
+        if (high < 0 || low < 0 || (i < 5 && value[i * 3 + 2] != ':')) return false;
+        out[i] = (uint8_t)((high << 4) | low);
+    }
+    return true;
+}
+
+static void fox_stop(void) {
+    if (s_fox_source == FOX_AP) wifi_manager_stop_monitor_mode();
+    if (s_fox_source == FOX_BLE) {
+        advertiser_scan_stop_tracking();
+        advertiser_scan_stop();
+    }
+    s_fox_source = FOX_NONE;
+}
+
+void handle_foxhunt_cmd(int argc, char **argv) {
+    if (argc == 2 && strcmp(argv[1], "stop") == 0) {
+        fox_stop();
+        glog("Fox Hunt stopped.\n");
+        return;
+    }
+    if (argc == 2 && strcmp(argv[1], "status") == 0) {
+        int8_t rssi = 0;
+        bool fresh = false;
+        bool active = s_fox_source == FOX_AP ?
+            wifi_manager_get_track_status(&rssi, &fresh) :
+            s_fox_source == FOX_BLE ? advertiser_scan_get_track_status(&rssi, &fresh) : false;
+        if (!active) { glog("Fox Hunt idle.\n"); return; }
+        glog("Fox Hunt %s: %d dBm, %s. Signal varies with reflections and orientation.\n",
+             s_fox_source == FOX_AP ? "AP" : "BLE", rssi, fresh ? "recent" : "stale");
+        return;
+    }
+    if (argc != 3 || (strcmp(argv[1], "ap") && strcmp(argv[1], "ble"))) {
+        glog("foxhunt ap|ble <MAC> | status | stop\nScan first; hunt from the current result list.\n");
+        return;
+    }
+    uint8_t mac[6];
+    if (!parse_address(argv[2], mac)) { glog("Invalid MAC address.\n"); return; }
+    if (ap_scan_is_running() || advertiser_scan_is_active()) {
+        glog("Stop the current scan before starting Fox Hunt.\n");
+        return;
+    }
+    fox_stop();
+    if (strcmp(argv[1], "ap") == 0) {
+        uint16_t count = 0;
+        wifi_ap_record_t *aps = NULL;
+        ap_scan_get_results(&count, &aps);
+        for (unsigned i = 0; aps && i < count; ++i) {
+            if (memcmp(aps[i].bssid, mac, 6)) continue;
+            if (ap_scan_select(i) != ESP_OK) break;
+            wifi_manager_track_ap();
+            if (wifi_manager_get_track_status(NULL, NULL)) s_fox_source = FOX_AP;
+            break;
+        }
+    } else {
+        int count = advertiser_scan_get_count();
+        for (int i = 0; i < count; ++i) {
+            AdvertiserDeviceInfo dev;
+            if (advertiser_scan_get_device(i, &dev) != 0 || memcmp(dev.mac, mac, 6)) continue;
+            if (advertiser_scan_start_tracking(i)) s_fox_source = FOX_BLE;
+            break;
+        }
+    }
+    if (s_fox_source == FOX_NONE)
+        glog("Target absent from the current scan. Scan again, then retry.\n");
+    else
+        glog("Fox Hunt active. Use 'foxhunt status' on the device; 'foxhunt stop' ends it.\n");
+}
+
+static void load_rules(void) {
+    if (s_loaded) return;
+    s_loaded = true;
+    rf_watch_init(&s_rules);
+    nvs_handle_t nvs;
+    if (nvs_open("rf_watch", NVS_READONLY, &nvs) != ESP_OK) return;
+    size_t size = sizeof(s_rules);
+    if (nvs_get_blob(nvs, "rules", &s_rules, &size) != ESP_OK ||
+        size != sizeof(s_rules) || !rf_watch_validate(&s_rules))
+        rf_watch_init(&s_rules);
+    nvs_close(nvs);
+}
+
+static bool save_rules(void) {
+    nvs_handle_t nvs;
+    if (nvs_open("rf_watch", NVS_READWRITE, &nvs) != ESP_OK) return false;
+    esp_err_t err = nvs_set_blob(nvs, "rules", &s_rules, sizeof(s_rules));
+    if (err == ESP_OK) err = nvs_commit(nvs);
+    nvs_close(nvs);
+    return err == ESP_OK;
+}
+
+static void format_mac(const uint8_t mac[6], char out[18]) {
+    snprintf(out, 18, "%02X:%02X:%02X:%02X:%02X:%02X",
+             mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+}
+
+static void usage(void) {
+    glog("rfwatch add ap ssid <name> | ap bssid <MAC>\n");
+    glog("rfwatch add ble name <name> | ble addr <MAC>\n");
+    glog("rfwatch list | remove <index> | clear | report\n");
+    glog("Run scanap; blescan -adv; blescan -s; bledetect; bledetect -s; then rfwatch report.\n");
+}
+
+static void list_rules(void) {
+    glog("RF Watch: %u/%u saved exact-match rules\n",
+         (unsigned)s_rules.count, (unsigned)RF_WATCH_MAX_RULES);
+    for (unsigned i = 0; i < s_rules.count; i++) {
+        const rf_watch_rule_t *r = &s_rules.rules[i];
+        if (r->kind == RF_WATCH_AP_BSSID || r->kind == RF_WATCH_BLE_ADDR) {
+            char mac[18];
+            format_mac(r->mac, mac);
+            glog("  [%u] %s %s\n", i, rf_watch_kind_name(r->kind), mac);
+        } else {
+            glog("  [%u] %s %s\n", i, rf_watch_kind_name(r->kind), r->text);
+        }
+    }
+}
+
+static void report(void) {
+    if (ap_scan_is_running() || advertiser_scan_is_active() ||
+        ble_device_detect_is_active()) {
+        glog("Finish/stop scans before rfwatch report to get stable results.\n");
+        return;
+    }
+    uint16_t ap_count = 0;
+    wifi_ap_record_t *aps = NULL;
+    ap_scan_get_results(&ap_count, &aps);
+    unsigned ap_hits = 0, ble_hits = 0, suspect_hits = 0;
+    for (unsigned i = 0; aps && i < ap_count; i++) {
+        for (unsigned j = 0; j < s_rules.count; j++) {
+            if (!rf_watch_ap_matches(&s_rules.rules[j], aps[i].ssid, aps[i].bssid))
+                continue;
+            ap_hits++;
+            if (ap_hits <= 16) {
+                char mac[18];
+                format_mac(aps[i].bssid, mac);
+                glog("AP match rule %u: BSSID %s, RSSI %d dBm, channel %u\n",
+                     j, mac, aps[i].rssi, (unsigned)aps[i].primary);
+            }
+            break;
+        }
+    }
+    int ble_count = advertiser_scan_get_count();
+    for (int i = 0; i < ble_count; i++) {
+        AdvertiserDeviceInfo info;
+        if (advertiser_scan_get_device(i, &info) != 0) continue;
+        for (unsigned j = 0; j < s_rules.count; j++) {
+            if (!rf_watch_ble_matches(&s_rules.rules[j], info.name, info.mac))
+                continue;
+            ble_hits++;
+            if (ble_hits <= 16) {
+                char mac[18];
+                format_mac(info.mac, mac);
+                glog("BLE match rule %u: address %s, RSSI %d dBm, seen %lu\n",
+                     j, mac, info.rssi, (unsigned long)info.seen_count);
+            }
+            break;
+        }
+    }
+    int detected_count = ble_device_detect_get_count();
+    for (int i = 0; i < detected_count; i++) {
+        BLEDetectDeviceInfo info;
+        if (ble_device_detect_get_device(i, &info) != 0 ||
+            info.type != BLE_DETECT_DEVICE_SKIMMER) continue;
+        suspect_hits++;
+        if (suspect_hits <= 8) {
+            char mac[18];
+            format_mac(info.mac, mac);
+            glog("BLE serial-module candidate: %s, address %s, RSSI %d dBm. "
+                 "Name match only; verify physically.\n", info.name, mac, info.rssi);
+        }
+    }
+    glog("RF Watch summary: %u AP matches (%u observed), %u BLE matches (%d observed), "
+         "%u serial-module candidates (%lu detect adverts).\n",
+         ap_hits, (unsigned)ap_count, ble_hits, ble_count, suspect_hits,
+         (unsigned long)ble_device_detect_get_rx_count());
+    glog("C3 BLE cannot see Classic Bluetooth; no match does not clear a location. "
+         "Free internal heap: %u bytes.\n",
+         (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
+}
+
+void handle_rfwatch_cmd(int argc, char **argv) {
+    load_rules();
+    if (argc == 2 && strcmp(argv[1], "list") == 0) { list_rules(); return; }
+    if (argc == 2 && strcmp(argv[1], "report") == 0) { report(); return; }
+    if (argc == 2 && strcmp(argv[1], "clear") == 0) {
+        rf_watch_init(&s_rules);
+        glog(save_rules() ? "RF Watch rules cleared and saved.\n" :
+                            "RF Watch rules cleared in RAM; NVS save failed.\n");
+        return;
+    }
+    if (argc == 3 && strcmp(argv[1], "remove") == 0) {
+        char *end;
+        unsigned long index = strtoul(argv[2], &end, 10);
+        if (end == argv[2] || *end || index >= RF_WATCH_MAX_RULES ||
+            !rf_watch_remove(&s_rules, (unsigned)index)) {
+            glog("Invalid RF Watch rule index.\n");
+            return;
+        }
+        glog(save_rules() ? "RF Watch rule removed and saved.\n" :
+                            "RF Watch rule removed in RAM; NVS save failed.\n");
+        return;
+    }
+    if (argc >= 5 && strcmp(argv[1], "add") == 0) {
+        rf_watch_kind_t kind = 0;
+        if (strcmp(argv[2], "ap") == 0 && strcmp(argv[3], "ssid") == 0)
+            kind = RF_WATCH_AP_SSID;
+        else if (strcmp(argv[2], "ap") == 0 && strcmp(argv[3], "bssid") == 0)
+            kind = RF_WATCH_AP_BSSID;
+        else if (strcmp(argv[2], "ble") == 0 && strcmp(argv[3], "name") == 0)
+            kind = RF_WATCH_BLE_NAME;
+        else if (strcmp(argv[2], "ble") == 0 && strcmp(argv[3], "addr") == 0)
+            kind = RF_WATCH_BLE_ADDR;
+        if (!kind) { usage(); return; }
+        char value[33] = {0};
+        size_t used = 0;
+        for (int i = 4; i < argc; i++) {
+            size_t len = strlen(argv[i]);
+            if ((i > 4 && used + 1 >= sizeof(value)) ||
+                len >= sizeof(value) - used - (i > 4 ? 1 : 0)) {
+                glog("RF Watch value too long.\n");
+                return;
+            }
+            if (i > 4) value[used++] = ' ';
+            memcpy(value + used, argv[i], len);
+            used += len;
+            value[used] = '\0';
+        }
+        if (!rf_watch_add(&s_rules, kind, value)) {
+            glog("Invalid/duplicate RF Watch rule, or eight-rule limit reached.\n");
+            return;
+        }
+        glog(save_rules() ? "RF Watch rule added and saved.\n" :
+                            "RF Watch rule added in RAM; NVS save failed.\n");
+        return;
+    }
+    usage();
+}
+
+#endif
