new file mode 100644
index 0000000..2e2b541
--- /dev/null
+++ b/main/gui/asteroids_game.c
@@ -0,0 +1,19 @@
+#include "gui/asteroids_game.h"
+#include "gui/round_demo.h"
+#include <string.h>
+#define Q 16
+#define WORLD (240*Q)
+static int16_t wrap_q4(int v){v%=WORLD;if(v<0)v+=WORLD;return (int16_t)v;}
+static int delta_q4(int a,int b){int d=a-b;if(d>WORLD/2)d-=WORLD;if(d< -WORLD/2)d+=WORLD;return d;}
+static uint32_t rnd(asteroids_game_t *g){uint32_t x=g->rng;x^=x<<13;x^=x>>17;x^=x<<5;return g->rng=x;}
+/* Shared sine values are signed Q7. */
+void asteroids_point(uint16_t a,int r,int *x,int *y){a&=1023;unsigned i=a>>2;int s=round_demo_wave[i],c=round_demo_wave[(i+64)&255];*x=(s*r)>>7;*y=-(c*r>>7);}
+static void spawn(asteroids_game_t *g,asteroid_body_t *r,unsigned size){uint32_t q=rnd(g);r->angle=(uint16_t)(q>>16);int ox,oy;asteroids_point(r->angle,48+(int)((q>>8)%38),&ox,&oy);r->x=(int16_t)((120+ox)*Q);r->y=(int16_t)((120+oy)*Q);int speed=1+(g->level-1)/2;if(speed>5)speed=5;r->vx=(int16_t)(((int)(q&7)-3)*speed);r->vy=(int16_t)(((int)((q>>3)&7)-3)*speed);r->size=(uint8_t)size;r->spin=(uint8_t)(1+(q>>12)%3);r->active=1;}
+static void spawn_wave(asteroids_game_t *g){unsigned count=3+g->level;if(count>9)count=9;for(unsigned i=0;i<ASTEROIDS_ROCKS;i++)g->rocks[i].active=0;for(unsigned i=0;i<count;i++)spawn(g,&g->rocks[i],2);}
+void asteroids_init(asteroids_game_t *g,uint32_t seed){memset(g,0,sizeof(*g));g->rng=seed?seed:1;g->x=g->y=120*Q;g->lives=3;g->level=1;spawn_wave(g);}
+void asteroids_step(asteroids_game_t *g,int thrust,int turn){if(!g->lives)return;g->ticks++;if(g->invuln)g->invuln--;g->angle=(uint16_t)((g->angle+turn)&1023);if(thrust){int ax,ay;asteroids_point(g->angle,2,&ax,&ay);g->vx+=ax;g->vy+=ay;}g->vx=(int16_t)(g->vx*254/256);g->vy=(int16_t)(g->vy*254/256);if(g->vx>24)g->vx=24;if(g->vx< -24)g->vx=-24;if(g->vy>24)g->vy=24;if(g->vy< -24)g->vy=-24;g->x=wrap_q4(g->x+g->vx);g->y=wrap_q4(g->y+g->vy);
+if(g->fire)g->fire--;else{for(unsigned i=0;i<ASTEROIDS_SHOTS;i++)if(!g->shots[i].active){int dx,dy;asteroids_point(g->angle,48,&dx,&dy);g->shots[i]=(asteroid_body_t){.x=g->x,.y=g->y,.vx=(int16_t)(g->vx+dx),.vy=(int16_t)(g->vy+dy),.active=1};g->fire=8;break;}}
+for(unsigned i=0;i<ASTEROIDS_SHOTS;i++)if(g->shots[i].active){asteroid_body_t *b=&g->shots[i];b->x=wrap_q4(b->x+b->vx);b->y=wrap_q4(b->y+b->vy);if(++b->spin>24)b->active=0;}
+for(unsigned i=0;i<ASTEROIDS_ROCKS;i++){asteroid_body_t *r=&g->rocks[i];if(!r->active)continue;r->x=wrap_q4(r->x+r->vx);r->y=wrap_q4(r->y+r->vy);r->angle=(uint16_t)((r->angle+r->spin)&1023);int dx=delta_q4(r->x,g->x),dy=delta_q4(r->y,g->y),hit=(r->size*6+5)*Q;if(!g->invuln&&dx*dx+dy*dy<hit*hit){g->lives--;g->x=g->y=120*Q;g->vx=g->vy=0;g->invuln=75;break;}for(unsigned j=0;j<ASTEROIDS_SHOTS;j++){asteroid_body_t *s=&g->shots[j];dx=delta_q4(r->x,s->x);dy=delta_q4(r->y,s->y);hit=(r->size*6+3)*Q;if(s->active&&dx*dx+dy*dy<hit*hit){int16_t impact_x=r->x,impact_y=r->y;s->active=r->active=0;g->score+=r->size==2?20:50;if(r->size==2)for(unsigned k=0;k<2;k++)for(unsigned n=0;n<ASTEROIDS_ROCKS;n++)if(!g->rocks[n].active){spawn(g,&g->rocks[n],1);g->rocks[n].x=impact_x;g->rocks[n].y=impact_y;break;}break;}}}
+int any=0;for(unsigned i=0;i<ASTEROIDS_ROCKS;i++)any|=g->rocks[i].active;if(!any&&g->level<99){g->level++;spawn_wave(g);}
+}
