diff --git a/include/gui/round_geometry.h b/include/gui/round_geometry.h
new file mode 100644
index 0000000..20b7967
--- /dev/null
+++ b/include/gui/round_geometry.h
@@ -0,0 +1,42 @@
+#pragma once
+
+/* Physical 240px aperture, with a 4px bezel/rounding allowance. No float,
+ * frame buffer, timer or allocation is needed to fit a horizontal band. */
+enum { ROUND_SCREEN_SIZE = 240, ROUND_CENTER = 120, ROUND_SAFE_RADIUS = 116 };
+enum { ROUND_KEYBOARD_TOP = 74, ROUND_KEYBOARD_HEIGHT = 126,
+       ROUND_KEYBOARD_WIDTH = 232, ROUND_KEYBOARD_GAP = 2 };
+
+static inline int round_band_width(int top, int bottom) {
+    if (top > bottom) return 0;
+    int a = top - ROUND_CENTER;
+    int b = bottom - ROUND_CENTER;
+    if (a < 0) a = -a;
+    if (b < 0) b = -b;
+    int dy = a > b ? a : b;
+    if (dy >= ROUND_SAFE_RADIUS) return 0;
+    unsigned square = ROUND_SAFE_RADIUS * ROUND_SAFE_RADIUS - dy * dy;
+    unsigned lo = 0, hi = ROUND_SAFE_RADIUS;
+    while (lo < hi) {
+        unsigned mid = (lo + hi + 1) / 2;
+        if (mid * mid <= square) lo = mid;
+        else hi = mid - 1;
+    }
+    return (int)lo * 2;
+}
+
+/* Add symmetric hidden keys to the normal 20-unit keyboard row. This uses
+ * LVGL's integer unit/gutter arithmetic, so its drawn keys and hit boxes stay
+ * identical. Includes the entire key rectangle, not just its centre line. */
+static inline int round_keyboard_spacer_units(int matrix_width, int keys,
+                                              int gap, int top, int bottom) {
+    int safe_width = round_band_width(top, bottom);
+    int inset = (matrix_width - safe_width + 1) / 2;
+    int available = matrix_width - gap * (keys + 1);
+    for (int spacer = 1; spacer <= 15; ++spacer) {
+        int total_units = 20 + 2 * spacer;
+        int first = available * spacer / total_units + gap;
+        int end = available * (spacer + 20) / total_units + keys * gap;
+        if (first >= inset && end <= matrix_width - inset) return spacer;
+    }
+    return 15;
+}
